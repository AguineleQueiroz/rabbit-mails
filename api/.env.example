APP_ENV=local
APP_DEBUG=true

DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=emailqueue
DB_USERNAME=user
DB_PASSWORD=secret

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672

# SMTP — Mailpit (captura local, sem autenticação)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_TLS=false
MAIL_FROM=noreply@emailqueue.local
MAIL_USER=
MAIL_PASS=

# SMTP — Brevo (produção, STARTTLS + AUTH LOGIN)
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_TLS=true
# MAIL_FROM=seuemail@dominio.com
# MAIL_USER=seuemail@dominio.com
# MAIL_PASS=sua-smtp-key-do-brevo

REDIS_HOST=redis
REDIS_PORT=6379

WORKER_ID=worker-1
HEARTBEAT_INTERVAL=5
RETRY_TTL_SECONDS=30
